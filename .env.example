# Postgres connection string.
# Local dev with the bundled docker-compose: postgresql://cms:cms@localhost:5432/cms
DATABASE_URL=postgresql://cms:cms@localhost:5432/cms
DATABASE_SSL=false

# Random 32+ byte secret used to sign the admin session cookie (JWT).
# Generate one with: openssl rand -base64 48
SESSION_SECRET=

# Absolute base URL this app is deployed at. Used to build absolute URLs
# for locally-stored media (/public/uploads/...) returned by the upload
# endpoint, since the public site consumes this API from a different domain.
APP_BASE_URL=http://localhost:3000

# One-time seed values consumed by `npm run seed:admin` — not read at runtime.
ADMIN_EMAIL=
ADMIN_PASSWORD=
